<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/caller_id_card_bg"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nexus Caller ID"
            android:textColor="#ABC7EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caller_id_dismiss"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:contentDescription="Dismiss caller card"
            android:text="✕"
            android:textColor="#E8EEF7"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/caller_id_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#E8EEF7"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/caller_id_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#C4D2E3"
        android:textSize="13sp" />
</LinearLayout>
